{
  "name": "TEK-COM Gestión (.NET 10 + PostgreSQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" }
  },
  "forwardPorts": [5276, 5432],
  "portsAttributes": {
    "5276": { "label": "Aplicación web", "onAutoForward": "openBrowser" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "ASPNETCORE_URLS": "http://0.0.0.0:5276",
    "ConnectionStrings__DefaultConnection": "Host=db;Database=tekcom;Username=postgres;Password=Codespace.Dev1",
    "SeedAdmin__Email": "admin@tekcom.local",
    "SeedAdmin__FullName": "Administrador",
    "SeedAdmin__Password": "Admin.Codespace1!"
  },
  "postCreateCommand": "dotnet restore Tekcom.Gestion.sln",
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit"]
    }
  }
}
