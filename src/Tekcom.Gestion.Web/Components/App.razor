<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // Tema claro/oscuro: se aplica antes de pintar para evitar el destello.
        (function () {
            try {
                var t = localStorage.getItem('tk-theme');
                if (!t) { t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
            window.tkTheme = {
                get: function () { return document.documentElement.getAttribute('data-theme') || 'light'; },
                set: function (t) { document.documentElement.setAttribute('data-theme', t); try { localStorage.setItem('tk-theme', t); } catch (e) { } }
            };
        })();
    </script>
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Tekcom.Gestion.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script>
        // Diagnóstico de la conexión en vivo: si a los 10 s la página interactiva sigue sin circuito, muestra un aviso
        // con los errores de la consola, para poder diagnosticar desde el celular sin herramientas de desarrollo.
        (function () {
            var errors = [];
            function push(kind, args) {
                try {
                    var text = Array.prototype.map.call(args, function (x) { return x && x.message ? x.message : String(x); }).join(' ');
                    errors.push(kind + ': ' + text.slice(0, 240));
                    if (errors.length > 6) { errors.shift(); }
                } catch (_) { }
            }
            var ce = console.error, cw = console.warn;
            console.error = function () { push('error', arguments); ce.apply(console, arguments); };
            console.warn = function () { push('aviso', arguments); cw.apply(console, arguments); };
            window.addEventListener('error', function (ev) { push('error', [ev.message || ev.error]); });
            window.addEventListener('unhandledrejection', function (ev) { push('rechazo', [ev.reason]); });
            window.__tkErrors = errors;
            setTimeout(function () {
                if (document.querySelector('[data-tk-live="1"]')) { return; }
                if (!document.querySelector('[data-tk-expect="1"]')) { return; }
                var box = document.createElement('div');
                box.id = 'tk-diag';
                var ua = (navigator.userAgent.match(/(Chrome|CriOS|Firefox|Safari)\/[\d.]+/) || [''])[0];
                box.innerHTML = '<strong>Sin conexión en vivo con el servidor</strong><br>' +
                    (errors.length ? errors.map(function (x) { return x.replace(/</g, '&lt;'); }).join('<br>') : '(la consola no registró errores)') +
                    '<br><span>' + location.protocol + ' · ' + ua + ' · blazor=' + (typeof Blazor !== 'undefined') + '</span>';
                document.body.appendChild(box);
            }, 10000);
        })();
    </script>
    <script>
        // Detalle al pasar el cursor o el dedo, o al enfocar con teclado: elementos con data-tip="valor|etiqueta".
        (function () {
            var tip = null;
            function ensure() {
                if (tip) { return tip; }
                tip = document.createElement('div');
                tip.id = 'tk-tip'; tip.setAttribute('role', 'tooltip');
                document.body.appendChild(tip);
                return tip;
            }
            function show(el, x, y) {
                var raw = el.getAttribute('data-tip') || '';
                var parts = raw.split('|');
                var t = ensure();
                t.textContent = '';
                var v = document.createElement('strong'); v.textContent = parts[0];
                t.appendChild(v);
                if (parts[1]) { var l = document.createElement('span'); l.textContent = parts[1]; t.appendChild(l); }
                t.style.display = 'block';
                var r = t.getBoundingClientRect();
                var left = Math.min(Math.max(8, x - r.width / 2), window.innerWidth - r.width - 8);
                var top = y - r.height - 14; if (top < 8) { top = y + 18; }
                t.style.left = left + 'px'; t.style.top = top + 'px';
            }
            function hide() { if (tip) { tip.style.display = 'none'; } }
            document.addEventListener('pointermove', function (e) {
                var el = e.target.closest && e.target.closest('[data-tip]');
                if (el) { show(el, e.clientX, e.clientY); } else { hide(); }
            });
            document.addEventListener('pointerdown', function (e) {
                var el = e.target.closest && e.target.closest('[data-tip]');
                if (el) { show(el, e.clientX, e.clientY); } else { hide(); }
            });
            document.addEventListener('focusin', function (e) {
                var el = e.target.closest && e.target.closest('[data-tip]');
                if (el) { var r = el.getBoundingClientRect(); show(el, r.left + r.width / 2, r.top); }
            });
            document.addEventListener('focusout', hide);
            document.addEventListener('scroll', hide, true);
        })();
        window.tkCountUp = function () {
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { return; }
            document.querySelectorAll('[data-count]').forEach(function (el) {
                var target = parseFloat(el.getAttribute('data-count'));
                if (isNaN(target) || el._counted === target) { return; }
                el._counted = target;
                var fmt = el.getAttribute('data-fmt');
                var show = function (v) {
                    if (fmt === 'money') { return (v < 0 ? '-$' : '$') + Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
                    if (fmt === 'pct') { return Math.round(v) + '%'; }
                    return Math.round(v).toLocaleString('en-US');
                };
                var start = null;
                var step = function (ts) {
                    if (start === null) { start = ts; }
                    var p = Math.min(1, (ts - start) / 800);
                    el.textContent = show(target * (1 - Math.pow(1 - p, 3)));
                    if (p < 1) { requestAnimationFrame(step); } else { el.textContent = show(target); }
                };
                requestAnimationFrame(step);
            });
        };
        window.tkNav = function () {
            document.body.classList.toggle('tk-show-nav');
            if (!window.tkNavBound) {
                window.tkNavBound = true;
                document.addEventListener('click', function (e) {
                    if (!document.body.classList.contains('tk-show-nav') || !e.target.closest) { return; }
                    if (e.target.closest('.tk-drawer a') || (!e.target.closest('.tk-drawer') && !e.target.closest('.dz-menu'))) { document.body.classList.remove('tk-show-nav'); }
                });
            }
        };
        window.tkFullscreen = function () {
            var el = document.documentElement;
            if (document.fullscreenElement) { document.exitFullscreen(); }
            else if (el.requestFullscreen) { el.requestFullscreen(); }
        };
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Las páginas de /Account se renderizan en el servidor sin interactividad
    // (necesitan HttpContext); el resto de la aplicación es interactiva.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
