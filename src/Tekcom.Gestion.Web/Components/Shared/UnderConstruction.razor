@* Página de una sección que todavía no tiene su sprint implementado. *@
<PageHeader Title="@Title" Subtitle="@Subtitle" />

<SectionCard>
    <EmptyState Title="@($"Esta sección se construye en el {Sprint}")" Icon="@Icons.Material.Outlined.Construction"
                Description="@Description">
        <a href="diseno" class="tk-btn tk-btn--outline mt-4">Ver el diseño previsto</a>
    </EmptyState>
</SectionCard>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter, EditorRequired] public string Sprint { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
}
