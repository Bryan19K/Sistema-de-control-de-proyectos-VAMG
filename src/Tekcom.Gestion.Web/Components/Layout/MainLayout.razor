@inherits LayoutComponentBase
@implements IDisposable
@using Tekcom.Gestion.Web.Services
@inject ThemeState Theme
@inject IJSRuntime JS

<MudThemeProvider Theme="TekcomTheme.Theme" IsDarkMode="Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<LiveProbe />

<MudLayout Class="tk-layout">
    <MudAppBar Elevation="0" Class="tk-appbar-mobile" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Abrir o cerrar menú" />
        <MudText Typo="Typo.subtitle1" Class="ml-1" Style="color:#fff">TEK-COM · Gestión</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Never" Class="tk-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="tk-main">
        <div class="tk-page">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // El tema ya se aplicó en la página (script de App.razor); aquí solo se sincroniza con MudBlazor.
            var saved = await JS.InvokeAsync<string>("tkTheme.get");
            Theme.Set(saved == "dark");
        }
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
