@using Tekcom.Gestion.Web.Services
@inject ThemeState Theme
@inject IJSRuntime JS

<div class="tk-brand">
    <span class="tk-brand__badge"><img class="tk-brand__logo" src="branding/logo.png" alt="TEK-COM" /></span>
    <span class="tk-brand__tag">Gestión de proyectos</span>
</div>

<MudNavMenu Class="tk-nav">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Dashboard">Inicio</MudNavLink>
    <MudNavLink Href="proyectos" Icon="@Icons.Material.Rounded.Folder">Proyectos</MudNavLink>
    <MudNavLink Href="plan-de-trabajo" Icon="@Icons.Material.Rounded.Timeline">Plan de trabajo</MudNavLink>
    <MudNavLink Href="sprints" Icon="@Icons.Material.Rounded.ViewKanban">Sprints y tareas</MudNavLink>
    <MudNavLink Href="nodos" Icon="@Icons.Material.Rounded.CellTower">Nodos y avance</MudNavLink>
    <MudNavLink Href="cronograma-nodos" Icon="@Icons.Material.Rounded.BarChart">Cronograma de nodos</MudNavLink>
    <MudNavLink Href="edificios" Icon="@Icons.Material.Rounded.Apartment">Edificios</MudNavLink>
    <MudNavLink Href="materiales" Icon="@Icons.Material.Rounded.Inventory2">Materiales</MudNavLink>
    <MudNavLink Href="seriales" Icon="@Icons.Material.Rounded.QrCode2">Seriales</MudNavLink>
    <MudNavLink Href="documentos" Icon="@Icons.Material.Rounded.Description">Documentos</MudNavLink>
    <MudNavLink Href="comparativo" Icon="@Icons.Material.Rounded.CompareArrows">Comparativo</MudNavLink>
    <MudNavLink Href="presentacion" Icon="@Icons.Material.Rounded.Slideshow">Presentación</MudNavLink>
    <MudNavLink Href="exportar" Icon="@Icons.Material.Rounded.FileDownload">Exportar</MudNavLink>
    <AuthorizeView Roles="@AppRoles.Admin">
        <MudNavLink Href="contratistas" Icon="@Icons.Material.Rounded.Engineering">Contratistas</MudNavLink>
        <MudNavLink Href="gastos" Icon="@Icons.Material.Rounded.Receipt">Gastos y precios</MudNavLink>
        <MudNavLink Href="configuracion" Icon="@Icons.Material.Rounded.Settings">Configuración</MudNavLink>
        <MudNavLink Href="importar" Icon="@Icons.Material.Rounded.UploadFile">Importar Excel</MudNavLink>
    </AuthorizeView>
</MudNavMenu>

<div class="tk-nav__footer">
    <button type="button" class="tk-theme-toggle" @onclick="ToggleThemeAsync" aria-pressed="@Theme.IsDark.ToString().ToLowerInvariant()">
        <MudIcon Icon="@(Theme.IsDark ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)" Size="Size.Small" />
        @(Theme.IsDark ? "Modo claro" : "Modo oscuro")
    </button>
    <AuthorizeView>
        <Authorized>
            <a href="Account/Manage" class="tk-nav__user" title="Mi cuenta">
                <UserAvatar Name="@context.User.Identity?.Name" Variant="UserAvatar.Style.Light" />
                <span class="tk-nav__user-name">@context.User.Identity?.Name</span>
            </a>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="tk-nav__logout">Cerrar sesión</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a href="Account/Login" class="tk-nav__logout">Iniciar sesión</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private async Task ToggleThemeAsync()
    {
        Theme.Set(!Theme.IsDark);
        await JS.InvokeVoidAsync("tkTheme.set", Theme.IsDark ? "dark" : "light");
    }
}
