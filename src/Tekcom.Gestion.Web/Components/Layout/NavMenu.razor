@inject NavigationManager Navigation

<div class="tk-brand">
    <span class="tk-brand__name">TEK-COM ·<br />Gestión</span>
</div>

<MudNavMenu Class="tk-nav">
    <MudNavLink Href="" Match="NavLinkMatch.All"><span class="tk-nav__dot"></span>Inicio</MudNavLink>
    <MudNavLink Href="proyectos"><span class="tk-nav__dot"></span>Proyectos</MudNavLink>
    <MudNavLink Href="plan-de-trabajo"><span class="tk-nav__dot"></span>Plan de trabajo</MudNavLink>
    <MudNavLink Href="sprints"><span class="tk-nav__dot"></span>Sprints y tareas</MudNavLink>
    <MudNavLink Href="nodos"><span class="tk-nav__dot"></span>Nodos y avance</MudNavLink>
    <MudNavLink Href="materiales"><span class="tk-nav__dot"></span>Materiales</MudNavLink>
    <MudNavLink Href="seriales"><span class="tk-nav__dot"></span>Seriales</MudNavLink>
    <MudNavLink Href="documentos"><span class="tk-nav__dot"></span>Documentos</MudNavLink>
    <MudNavLink Href="exportar"><span class="tk-nav__dot"></span>Exportar</MudNavLink>
    <AuthorizeView Roles="@AppRoles.Admin">
        <MudNavLink Href="diseno"><span class="tk-nav__dot"></span>Diseño</MudNavLink>
    </AuthorizeView>
</MudNavMenu>

<div class="tk-nav__footer">
    <AuthorizeView>
        <Authorized>
            <a href="Account/Manage" class="tk-nav__user" title="Mi cuenta">
                <UserAvatar Name="@context.User.Identity?.Name" Variant="UserAvatar.Style.Light" />
                <span class="tk-nav__user-name">@context.User.Identity?.Name</span>
            </a>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="tk-nav__logout">Cerrar sesión</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a href="Account/Login" class="tk-nav__logout">Iniciar sesión</a>
        </NotAuthorized>
    </AuthorizeView>
</div>
