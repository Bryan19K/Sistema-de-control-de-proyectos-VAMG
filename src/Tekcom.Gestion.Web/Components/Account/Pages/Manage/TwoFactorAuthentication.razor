@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Identity
@using Tekcom.Gestion.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Verificación en dos pasos · TEK-COM</PageTitle>

<StatusMessage />
<h3 class="mud-typography mud-typography-h6 mb-3">Verificación en dos pasos (2FA)</h3>

@if (is2faEnabled)
{
    if (recoveryCodesLeft == 0)
    {
        <div class="alert alert-danger">
            <strong>No le quedan códigos de recuperación.</strong>
            <p>Debe <a href="Account/Manage/GenerateRecoveryCodes">generar un nuevo juego de códigos</a> antes de poder ingresar con uno.</p>
        </div>
    }
    else if (recoveryCodesLeft == 1)
    {
        <div class="alert alert-danger">
            <strong>Le queda 1 código de recuperación.</strong>
            <p>Puede <a href="Account/Manage/GenerateRecoveryCodes">generar un nuevo juego de códigos</a>.</p>
        </div>
    }
    else if (recoveryCodesLeft <= 3)
    {
        <div class="alert alert-danger">
            <strong>Le quedan @recoveryCodesLeft códigos de recuperación.</strong>
            <p>Conviene <a href="Account/Manage/GenerateRecoveryCodes">generar un nuevo juego de códigos</a>.</p>
        </div>
    }

    <div class="form-actions">
        @if (isMachineRemembered)
        {
            <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn-primary">Olvidar este navegador</button>
            </form>
        }
        <a href="Account/Manage/Disable2fa" class="btn-secondary">Desactivar 2FA</a>
        <a href="Account/Manage/GenerateRecoveryCodes" class="btn-secondary">Restablecer códigos de recuperación</a>
    </div>
}

<h4 class="mud-typography mud-typography-subtitle1 mt-4 mb-2">Aplicación de autenticación</h4>
<div class="form-actions">
    @if (!hasAuthenticator)
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn-primary">Agregar aplicación de autenticación</a>
    }
    else
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn-primary">Configurar aplicación de autenticación</a>
        <a href="Account/Manage/ResetAuthenticator" class="btn-secondary">Restablecer aplicación de autenticación</a>
    }
</div>

@code {
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Se olvidó este navegador. La próxima vez que ingrese desde aquí se le pedirá el código de verificación.",
            HttpContext);
    }
}
