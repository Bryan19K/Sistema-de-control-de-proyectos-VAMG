<PageHeader Title="Sprint 3 · FTTH Nextwave Sonsonate" Subtitle="20 oct – 6 nov (18 días) · Objetivo: cerrar SON19 y avanzar SON22">
    <Actions>
        <button type="button" class="tk-btn tk-btn--outline">Backlog (12)</button>
        <button type="button" class="tk-btn tk-btn--outline">Cerrar sprint</button>
        <button type="button" class="tk-btn tk-btn--primary">+ Tarea</button>
    </Actions>
</PageHeader>

<div class="tk-card tk-sprint-bar">
    <PaceBar Progress="38" Elapsed="62" ShowLabel="false" />
    <span class="tk-sprint-bar__stat">Completado <strong>38%</strong></span>
    <span class="tk-sprint-bar__stat">Tiempo <strong>62%</strong></span>
    <StatusChip Status="StatusChip.Kind.Atrasado" Text="Atrasado · 3 días" />
</div>

<div class="tk-kanban">
    @foreach (var col in Columns)
    {
        <div class="tk-kanban__col">
            <div class="tk-kanban__head"><span>@col.Name</span><span class="tk-kanban__count">@col.Count</span></div>
            @foreach (var t in col.Tasks)
            {
                <div class="tk-task @(col.Done ? "tk-task--done" : "")">
                    <div class="tk-task__title">@t.Title</div>
                    <div class="tk-task__meta">
                        <span class="tk-task__link">
                            @if (t.Due is not null)
                            {
                                <StatusChip Status="t.Due.Value" Text="@t.DueText" />
                            }
                            else if (t.Link is not null)
                            {
                                <MudIcon Icon="@(col.Done ? Icons.Material.Filled.Check : t.Icon)" /> <span>@t.Link</span>
                            }
                        </span>
                        <UserAvatar Name="@t.Owner" Variant="@(col.Done ? UserAvatar.Style.Muted : (t.Owner == "N" ? UserAvatar.Style.Purple : UserAvatar.Style.Navy))" />
                    </div>
                </div>
            }
            @if (col.More > 0)
            {
                <div class="tk-kanban__more">+@col.More más</div>
            }
        </div>
    }
</div>

@code {
    private sealed record TaskCard(string Title, string Owner, string? Link = null, string Icon = "", StatusChip.Kind? Due = null, string? DueText = null);
    private sealed record Column(string Name, int Count, TaskCard[] Tasks, bool Done = false, int More = 0);

    private static readonly Column[] Columns =
    [
        new("Por hacer", 4,
        [
            new("Conteo físico de bodega SON22", "N", Due: StatusChip.Kind.Manana),
            new("Solicitar MPO 400 m faltantes (3)", "B", Link: "Materiales", Icon: Icons.Material.Outlined.Link),
            new("Definir fecha de inicio SON23", "B", Due: StatusChip.Kind.Vencida),
            new("Minuta semanal", "N", Due: StatusChip.Kind.Neutral, DueText: "Lun"),
        ]),
        new("En proceso", 3,
        [
            new("Instalación de NAP en SON19", "B", Link: "Nodo SON19 · 2/5", Icon: Icons.Material.Outlined.Link),
            new("Tendido de fibra SON22", "N", Link: "Nodo SON22", Icon: Icons.Material.Outlined.Link),
            new("Registrar seriales SFP de LC5–LC8", "B", Link: "Seriales", Icon: Icons.Material.Outlined.Link),
        ]),
        new("En revisión", 2,
        [
            new("ATP de instalación de OLT", "B", Due: StatusChip.Kind.Hoy),
            new("Reporte de entregas a contratistas", "N", Link: "2", Icon: Icons.Material.Outlined.AttachFile),
        ]),
        new("Hecho", 6,
        [
            new("Recepción 3ra entrega de materiales", "B", Link: "25 oct"),
            new("Corregir catálogo de equivalencias", "N", Link: "24 oct"),
            new("Cableado eléctrico OLT", "B", Link: "22 oct"),
        ], Done: true, More: 3),
    ];
}
