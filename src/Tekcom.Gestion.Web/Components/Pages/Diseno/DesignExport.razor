<PageHeader Title="Exportar reportes" Subtitle='Todos los archivos llevan logo TEK-COM, fecha de corte y "Elaborado por"' />

<div class="tk-two-col">
    <SectionCard Title="Configuración">
        <div class="tk-form-field">
            <label>Reporte</label>
            <select><option>Consolidado de materiales</option><option>Entregas por nodo</option><option>Inventario de bodega</option><option>Liquidación (acta)</option><option>Estado de sprints</option><option>Plan de trabajo</option></select>
        </div>
        <div class="tk-form-field">
            <label>Proyecto</label>
            <select><option>FTTH Nextwave Sonsonate</option><option>Escalón 93</option></select>
        </div>
        <div class="tk-form-field">
            <label>Fecha de corte</label>
            <input type="text" value="30/10/2026" readonly />
        </div>
        <div class="tk-form-field">
            <label>Formato</label>
            <div class="tk-check-row">
                <label><input type="checkbox" checked /> Excel (.xlsx)</label>
                <label><input type="checkbox" checked /> PDF</label>
            </div>
        </div>
        <div class="tk-form-field">
            <label>Plantilla de diseño</label>
            <select><option>Estándar TEK-COM</option></select>
        </div>
        <button type="button" class="tk-btn tk-btn--primary">Generar archivos</button>
        <p class="tk-help">
            <strong>Reportes disponibles:</strong> plan de trabajo, avance por nodo, consolidado de materiales,
            entregas por nodo, inventario de bodega, seriales SFP, estado de sprints, minuta.
        </p>
    </SectionCard>

    <SectionCard Title="Vista previa">
        <div class="tk-export-preview">
            <div class="tk-export-preview__head">
                <span class="tk-logo-placeholder">LOGO TEK-COM</span>
                <div class="tk-export-preview__title">
                    <strong>Consolidado de materiales</strong>
                    <span>FTTH Nextwave Sonsonate · Corte 30/10/2026</span>
                </div>
            </div>
            <table class="tk-table">
                <thead><tr><th>Material</th><th>Recibido</th><th>Entregado</th><th>Stock</th></tr></thead>
                <tbody>
                    <tr><td>NAP de paso</td><td class="num">160</td><td class="num">142</td><td class="num">18</td></tr>
                    <tr><td>NAP final</td><td class="num">80</td><td class="num">69</td><td class="num">11</td></tr>
                    <tr><td>Cable MPO 400 m</td><td class="num">6</td><td class="num">6</td><td class="num">0</td></tr>
                    <tr><td>Fibra óptica 500 m</td><td class="num">10</td><td class="num">9</td><td class="num">1</td></tr>
                    <tr><td class="muted">…</td><td></td><td></td><td></td></tr>
                </tbody>
            </table>
            <div class="tk-export-preview__foot">
                <span>Elaborado por: Bryan Calderón</span>
                <span>Página 1 de 2</span>
            </div>
        </div>
    </SectionCard>
</div>
