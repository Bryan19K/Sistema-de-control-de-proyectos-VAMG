@page "/"
@attribute [Authorize]

<PageTitle>Inicio · TEK-COM</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Inicio</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Bienvenido al sistema de gestión de proyectos de TEK-COM.
</MudText>

<MudPaper Class="pa-6" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Construction" Color="Color.Secondary" Size="Size.Large" />
        <MudText Typo="Typo.body2">
            El tablero de indicadores se construirá en el Sprint 5. Por ahora use el menú lateral para navegar.
        </MudText>
    </MudStack>
</MudPaper>
