@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Models
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Web.Services
@inject IUserAdminService Users
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject UserAccess Access

<div class="tk-toolbar">
    <span class="grow tk-muted">No hay registro público: los usuarios los crea un administrador. Si alguien olvida su contraseña, restablézcala aquí.</span>
    <button type="button" class="tk-btn tk-btn--primary" @onclick="CreateAsync">+ Nuevo usuario</button>
</div>

<div class="tk-table-wrap">
    <table class="tk-table">
        <thead><tr><th>Usuario</th><th>Nombre</th><th>Roles</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in _users)
            {
                var user = u;
                <tr>
                    <td>@user.Email</td>
                    <td>@(string.IsNullOrWhiteSpace(user.FullName) ? "—" : user.FullName)</td>
                    <td>@string.Join(", ", user.Roles.Select(UiText.RoleName))</td>
                    <td>@if (user.IsLockedOut) { <StatusChip Status="StatusChip.Kind.Atrasado" Text="Bloqueado" /> } else { <StatusChip Status="StatusChip.Kind.Ok" Text="Activo" /> }</td>
                    <td class="tk-actions-cell">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => RolesAsync(user)">Roles</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => PasswordAsync(user)">Contraseña</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ToggleLockAsync(user)">@(user.IsLockedOut ? "Desbloquear" : "Bloquear")</MudButton>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<UserListItem> _users = [];

    protected override async Task OnInitializedAsync() => _users = await Users.ListAsync();

    private async Task ShowAsync(string title, UserDialogs.DialogMode mode, UserListItem? user = null)
    {
        var dialog = await Dialogs.ShowAsync<UserDialogs>(title,
            new DialogParameters { ["Mode"] = mode, ["UserId"] = user?.Id, ["Email"] = user?.Email, ["CurrentRoles"] = user?.Roles },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            _users = await Users.ListAsync();
        }
    }

    private Task CreateAsync() => ShowAsync("Nuevo usuario", UserDialogs.DialogMode.Create);
    private Task RolesAsync(UserListItem user) => ShowAsync("Roles del usuario", UserDialogs.DialogMode.Roles, user);
    private Task PasswordAsync(UserListItem user) => ShowAsync("Cambiar contraseña", UserDialogs.DialogMode.Password, user);

    private async Task ToggleLockAsync(UserListItem user)
    {
        try
        {
            await Users.SetLockedAsync(user.Id, !user.IsLockedOut, await Access.UserIdAsync());
            _users = await Users.ListAsync();
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
