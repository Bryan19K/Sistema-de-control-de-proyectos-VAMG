@page "/configuracion"
@attribute [Authorize(Roles = AppRoles.Admin)]

<PageTitle>Configuración · TEK-COM</PageTitle>

<PageHeader Title="Configuración" Subtitle="Brigadas, supervisores, etapas del flujo, tipos de proyecto, usuarios, notificaciones y colores del dashboard">
    <Actions>
        <a href="importar" class="tk-btn tk-btn--outline">Importar Excel</a>
    </Actions>
</PageHeader>

<SectionCard>
    <MudTabs Elevation="0" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
        <MudTabPanel Text="Contratistas"><PeopleTab Kind="NameDialog.PersonKind.Contractor" /></MudTabPanel>
        <MudTabPanel Text="Clientes"><ClientsTab /></MudTabPanel>
        <MudTabPanel Text="Supervisores"><PeopleTab Kind="NameDialog.PersonKind.Supervisor" /></MudTabPanel>
        <MudTabPanel Text="Etapas del flujo"><StagesTab /></MudTabPanel>
        <MudTabPanel Text="Tipos de proyecto"><ProjectTypesTab /></MudTabPanel>
        <MudTabPanel Text="Usuarios"><UsersTab /></MudTabPanel>
        <MudTabPanel Text="Notificaciones"><NotificationsTab /></MudTabPanel>
        <MudTabPanel Text="Metas"><GoalsTab /></MudTabPanel>
        <MudTabPanel Text="Apariencia"><AppearanceTab /></MudTabPanel>
    </MudTabs>
</SectionCard>
