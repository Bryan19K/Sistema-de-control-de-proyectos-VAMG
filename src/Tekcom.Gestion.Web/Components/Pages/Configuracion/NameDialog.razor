@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Entities
@inject IReferenceDataService Reference
@inject ISnackbar Snackbar
@inject IDeletionService Deletion
@inject IDialogService Dialogs
@inject Tekcom.Gestion.Web.Services.UserAccess Access

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_name" Label="Nombre" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            @if (Kind == PersonKind.Contractor)
            {
                <MudTextField @bind-Value="_responsible" Label="Responsable de la brigada" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
            <MudTextField @bind-Value="_phone" Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudCheckBox T="bool" @bind-Value="_active" Label="Activo" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_isAdmin && Id != 0)
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync" Style="margin-right:auto">Eliminar</MudButton>
        }
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public enum PersonKind { Contractor, Supervisor }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PersonKind Kind { get; set; }
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Responsible { get; set; }
    [Parameter] public string? Phone { get; set; }
    [Parameter] public bool Active { get; set; } = true;

    private string? _name;
    private string? _responsible;
    private string? _phone;
    private bool _active = true;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await Access.IsAdminAsync();
        _name = Name;
        _responsible = Responsible;
        _phone = Phone;
        _active = Active;
    }

    private async Task DeleteAsync()
    {
        var what = Kind == PersonKind.Contractor ? "contratista" : "supervisor";
        var ok = await DeleteConfirmDialog.AskAsync(Dialogs, $"Eliminar {what}", $"¿Eliminar a «{_name}»?",
            [
                Kind == PersonKind.Contractor
                    ? "Si tiene nodos o movimientos de bodega a su nombre no se puede: en ese caso desmarque «Activo»."
                    : "Si supervisa nodos no se puede: cámbieles el supervisor primero, o desmarque «Activo».",
                "Queda registrado quién lo eliminó.",
            ]);
        if (ok is null)
        {
            return;
        }

        try
        {
            if (Kind == PersonKind.Contractor)
            {
                await Deletion.DeleteContractorAsync(Id);
            }
            else
            {
                await Deletion.DeleteSupervisorAsync(Id);
            }

            Snackbar.Add($"«{_name}» eliminado.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error, o => o.RequireInteraction = true);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (Kind == PersonKind.Contractor)
            {
                await Reference.SaveContractorAsync(new Contractor { Id = Id, Name = _name ?? string.Empty, ResponsibleName = _responsible, Phone = _phone, IsActive = _active });
            }
            else
            {
                await Reference.SaveSupervisorAsync(new Supervisor { Id = Id, Name = _name ?? string.Empty, Phone = _phone, IsActive = _active });
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
