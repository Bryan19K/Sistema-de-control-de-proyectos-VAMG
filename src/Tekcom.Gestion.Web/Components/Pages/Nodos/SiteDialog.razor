@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Entities
@using Tekcom.Gestion.Domain.Enums
@inject ISiteService Sites
@inject IReferenceDataService Reference
@inject ISnackbar Snackbar
@inject IDeletionService Deletion
@inject IDialogService Dialogs
@inject Tekcom.Gestion.Web.Services.UserAccess Access

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.Code" Label="Código del nodo" Required="true" Placeholder="SON19" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="_model.Zone" Label="Zona o sitio" Placeholder="SONSONATE" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" @bind-Value="_model.ContractorId" Label="Brigada / contratista" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var c in _contractors)
                    {
                        <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" @bind-Value="_model.SupervisorId" Label="Supervisor responsable" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var s in _supervisors)
                    {
                        <MudSelectItem T="int?" Value="s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6"><DatePick Label="Fecha de inicio" @bind-Value="_model.PlannedStart" /></MudItem>
            <MudItem xs="12" sm="6"><DatePick Label="Fecha final" @bind-Value="_model.PlannedEnd" /></MudItem>
            <MudItem xs="12" sm="6"><DatePick Label="Inicio real" @bind-Value="_model.ActualStart" /></MudItem>
            <MudItem xs="12" sm="6"><DatePick Label="Final real" @bind-Value="_model.ActualEnd" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="double?" @bind-Value="_model.Latitude" Label="Latitud" Format="0.######" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="double?" @bind-Value="_model.Longitude" Label="Longitud" Format="0.######" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Notes" Label="Notas" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Orden de construcción</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4"><MudNumericField T="int?" @bind-Value="_model.HomesPassed" Label="HP (hogares que pasa)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.ElectricalPermitStatus" Label="Permisos eléctricos" Placeholder="Aprobado" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="bool?" @bind-Value="_model.MaterialsDelivered" Label="Materiales entregados" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="bool?" Value="true">Sí</MudSelectItem>
                    <MudSelectItem T="bool?" Value="false">No</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="ClosureDocStatus?" @bind-Value="_model.KmzStatus" Label="KMZ" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="ClosureDocStatus?" Value="ClosureDocStatus.Validated">Validada</MudSelectItem>
                    <MudSelectItem T="ClosureDocStatus?" Value="ClosureDocStatus.PendingContractor">Pendiente por contratista</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="ClosureDocStatus?" @bind-Value="_model.UmConsolidatedStatus" Label="Consolidado de UM" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="ClosureDocStatus?" Value="ClosureDocStatus.Validated">Validada</MudSelectItem>
                    <MudSelectItem T="ClosureDocStatus?" Value="ClosureDocStatus.PendingContractor">Pendiente por contratista</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="ClosureDocStatus?" @bind-Value="_model.PhotoReportStatus" Label="Reporte fotográfico" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="ClosureDocStatus?" Value="ClosureDocStatus.Validated">Validada</MudSelectItem>
                    <MudSelectItem T="ClosureDocStatus?" Value="ClosureDocStatus.PendingContractor">Pendiente por contratista</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="bool?" @bind-Value="_model.AtpDelivered" Label="ATP entregado" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="bool?" Value="true">Sí</MudSelectItem>
                    <MudSelectItem T="bool?" Value="false">No</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (_isAdmin && _model.Id != 0)
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync" Style="margin-right:auto">Eliminar nodo</MudButton>
        }
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public Site? Model { get; set; }

    private Site _model = new();
    private List<Contractor> _contractors = [];
    private List<Supervisor> _supervisors = [];
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await Access.IsAdminAsync();
        _contractors = await Reference.ContractorsAsync();
        _supervisors = await Reference.SupervisorsAsync();
        _model = Model is null
            ? new Site { ProjectId = ProjectId }
            : new Site
            {
                Id = Model.Id, ProjectId = Model.ProjectId, Code = Model.Code, Zone = Model.Zone,
                Latitude = Model.Latitude, Longitude = Model.Longitude, ContractorId = Model.ContractorId,
                SupervisorId = Model.SupervisorId, PlannedStart = Model.PlannedStart, PlannedEnd = Model.PlannedEnd,
                ActualStart = Model.ActualStart, ActualEnd = Model.ActualEnd, Notes = Model.Notes,
                HomesPassed = Model.HomesPassed, ElectricalPermitStatus = Model.ElectricalPermitStatus, MaterialsDelivered = Model.MaterialsDelivered,
                KmzStatus = Model.KmzStatus, UmConsolidatedStatus = Model.UmConsolidatedStatus, PhotoReportStatus = Model.PhotoReportStatus, AtpDelivered = Model.AtpDelivered,
            };
    }

    private async Task DeleteAsync()
    {
        var impact = await Deletion.SiteImpactAsync(_model.Id);
        var reason = await DeleteConfirmDialog.AskAsync(Dialogs, "Eliminar nodo", $"¿Eliminar el nodo {_model.Code} con todo lo suyo?",
            [
                "Se ocultan sus etapas, proyectado, ajustes, mediciones, tareas y documentos.",
                $"Se anulan sus {impact.Movements} movimientos de bodega (lo entregado vuelve al stock).",
                "Los gastos del dinero no se tocan.",
                "Queda registrado quién lo eliminó y por qué; no se destruye nada en la base.",
            ], askReason: true, confirmText: _model.Code, buttonLabel: "Eliminar nodo");
        if (reason is null)
        {
            return;
        }

        try
        {
            await Deletion.DeleteSiteAsync(_model.Id, reason);
            Snackbar.Add($"Nodo {_model.Code} eliminado.", Severity.Success);
            MudDialog.Close(DialogResult.Ok("deleted"));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            var saved = await Sites.SaveAsync(_model);
            MudDialog.Close(DialogResult.Ok(saved.Id));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
