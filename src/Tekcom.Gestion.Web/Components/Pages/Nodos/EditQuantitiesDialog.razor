@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Common.Interfaces
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Web.Services
@inject IInventoryService Inventory
@inject IProjectionService Projection
@inject IDateTimeProvider Clock
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <p class="mb-3"><strong>@MaterialName</strong> · @Unit</p>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudNumericField Format="0.##" Immediate="true" T="decimal" @bind-Value="_projected" Min="0" Label="Proyectado vigente"
                                 HelperText="@($"Hoy: {UiText.Number(Projected)}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField Format="0.##" Immediate="true" T="decimal" @bind-Value="_delivered" Min="0" Label="Entregado" Disabled="!TracksStock"
                                 HelperText="@($"Hoy: {UiText.Number(Delivered)}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField Format="0.##" Immediate="true" T="decimal" @bind-Value="_installed" Min="0" Label="Instalado"
                                 HelperText="@($"Hoy: {UiText.Number(Installed)}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
        <div class="mt-3"><DatePick Label="Fecha de la corrección" @bind-Value="_date" /></div>
        <MudTextField @bind-Value="_reason" Label="@(NeedsReason ? "Motivo (obligatorio)" : "Motivo o nota (opcional)")" Lines="2" Class="mt-3" Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="Todo queda registrado: lo proyectado como ajuste con motivo, y lo entregado e instalado como movimientos. Si baja una cantidad se anulan registros, no se borran." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int SiteId { get; set; }
    [Parameter] public int MaterialId { get; set; }
    [Parameter] public string MaterialName { get; set; } = string.Empty;
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public bool TracksStock { get; set; } = true;
    [Parameter] public decimal Projected { get; set; }
    [Parameter] public decimal Delivered { get; set; }
    [Parameter] public decimal Installed { get; set; }

    private decimal _projected;
    private decimal _delivered;
    private decimal _installed;
    private DateOnly? _date;
    private string? _reason;

    private bool NeedsReason => _projected != Projected || _installed < Installed || _delivered < Delivered;

    protected override void OnInitialized()
    {
        _projected = Projected;
        _delivered = Delivered;
        _installed = Installed;
        _date = Clock.Today;
    }

    private async Task SaveAsync()
    {
        var date = _date ?? Clock.Today;
        try
        {
            if (_projected != Projected)
            {
                if (string.IsNullOrWhiteSpace(_reason))
                {
                    throw new BusinessRuleException("Para corregir lo proyectado escriba el motivo.");
                }

                await Projection.SetProjectedTotalAsync(SiteId, MaterialId, _projected, _reason!, date);
            }

            if (TracksStock && _delivered != Delivered)
            {
                await Inventory.SetDeliveredTotalAsync(ProjectId, SiteId, MaterialId, _delivered, date, _reason);
            }

            if (_installed != Installed)
            {
                await Inventory.SetInstalledTotalAsync(ProjectId, SiteId, MaterialId, _installed, date, _reason);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
