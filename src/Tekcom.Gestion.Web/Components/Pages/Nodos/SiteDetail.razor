@page "/nodos/{Id:int}"
@attribute [Authorize]
@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Models
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Entities
@using Tekcom.Gestion.Domain.Enums
@using Tekcom.Gestion.Web.Services
@using Tekcom.Gestion.Web.Components.Pages.Materiales
@inject ISiteService Sites
@inject IQuantityService Quantities
@inject IProjectService Projects
@inject IProjectionService Projections
@inject IMeasurementService Measurements
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDeletionService Deletion
@inject ProjectSelection Selection
@inject UserAccess Access

<PageTitle>Nodo @(_summary?.Site.Code) · TEK-COM</PageTitle>

@if (_summary is null)
{
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <EmptyState Title="El nodo no existe" Icon="@Icons.Material.Outlined.SearchOff">
            <a href="nodos" class="tk-btn tk-btn--outline mt-4">Volver a nodos</a>
        </EmptyState>
    }
}
else
{
    var site = _summary.Site;
    <PageHeader Title="@($"Nodo {site.Code}")"
                Subtitle="@($"{_project?.Name} · {site.Zone ?? "Sin zona"} · {site.Contractor?.Name ?? "Sin brigada"} · Supervisor: {site.Supervisor?.Name ?? "—"}")">
        <Actions>
            <a href="nodos" class="tk-btn tk-btn--outline">Todos los nodos</a>
            <a href="@($"documentos?nodo={site.Id}")" class="tk-btn tk-btn--outline">Documentos</a>
            <a href="@($"exportes/atp/pdf?proyecto={site.ProjectId}&nodo={site.Id}")" class="tk-btn tk-btn--outline" download>ATP PDF</a>
            @if (site.MapUrl is not null)
            {
                <a href="@site.MapUrl" target="_blank" rel="noopener" class="tk-btn tk-btn--outline">Ver en el mapa</a>
            }
            @if (_canEdit)
            {
                <button type="button" class="tk-btn tk-btn--primary" @onclick="EditAsync">Editar nodo</button>
            }
        </Actions>
    </PageHeader>

    <div class="tk-kpi-grid">
        <KpiCard Label="Avance global del nodo" Value="@($"{_summary.GlobalPercent:0.#}%")" Href="@($"nodos/{Id}#sec-cantidades")"
                 Note="@(_summary.PiecesPercent is null ? "por etapas (el nodo no tiene proyección)" : "por piezas instaladas sobre lo proyectado")" Tone="KpiCard.NoteTone.Info" />
        <KpiCard Label="Avance por etapas" Value="@($"{_summary.ProgressPercent:0.#}%")" Href="@($"nodos/{Id}#sec-etapas")" Note="ponderado por días de cada etapa" />
        <KpiCard Label="Tiempo transcurrido" Value="@($"{_summary.Pace.ElapsedPercent:0.#}%")"
                 Note="@($"{UiText.Date(site.PlannedStart)} – {UiText.Date(site.PlannedEnd)}")" />
        <KpiCard Label="Viñetas del nodo" Value="@UiText.Number(_summary.VinetasInstalled)" Href="@($"nodos/{Id}#sec-cantidades")"
                 Note="@($"instaladas de {UiText.Number(_summary.VinetasProjected)} · suma de los elementos de red")" Tone="@(_summary.VinetasProjected > 0 && _summary.VinetasInstalled >= _summary.VinetasProjected ? KpiCard.NoteTone.Success : KpiCard.NoteTone.Info)" />
        <KpiCard Label="Avance de FATs" Value="@($"{_summary.FatPercent:0.#}%")" Href="@($"nodos/{Id}#sec-mediciones")"
                 Note="@(_summary.ReadyToMeasure ? "Listo para medir" : $"Se mide con {_project?.ReadyToMeasurePercent}%")"
                 Tone="_summary.ReadyToMeasure ? KpiCard.NoteTone.Warning : KpiCard.NoteTone.Neutral" />
        <KpiCard Label="Entrega al cliente" Value="@(site.IsReadyToDeliver ? "Listo" : "Pendiente")" Href="@($"nodos/{Id}#sec-control")"
                 Note="ODN y feeder finalizados" Tone="site.IsReadyToDeliver ? KpiCard.NoteTone.Success : KpiCard.NoteTone.Neutral" />
    </div>

    <div class="tk-dash-grid">
        <div id="sec-etapas" class="tk-anchor"><SectionCard Title="Etapas del nodo">
            <HeaderActions><PaceChip Pace="_summary.Pace" /></HeaderActions>
            <ChildContent>
                <div class="tk-table-wrap">
                    <table class="tk-table">
                        <thead><tr><th>Etapa</th><th>Estado</th><th>Inicio</th><th>Fin</th><th>Notas</th></tr></thead>
                        <tbody>
                            @foreach (var stage in _stages)
                            {
                                var local = stage;
                                <tr>
                                    <td><a class="tk-row-link" role="button" tabindex="0" @onclick="() => ShowStageAsync(local)">@local.Definition?.Name</a></td>
                                    <td>
                                        @if (_canEdit)
                                        {
                                            <MudSelect T="StageStatus" Value="local.Status" ValueChanged="status => SetStageAsync(local, status)"
                                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="tk-inline-select">
                                                @foreach (var option in OptionsFor(local.Code))
                                                {
                                                    <MudSelectItem T="StageStatus" Value="option">@UiText.StageStatusName(option)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        }
                                        else
                                        {
                                            <StatusChip Status="UiText.StageStatusKind(local.Status)" Text="@UiText.StageStatusName(local.Status)" />
                                        }
                                    </td>
                                    <td>@UiText.Date(local.ActualStart)</td>
                                    <td>@UiText.Date(local.ActualEnd) @if (_canEdit) { <MudIconButton Icon="@Icons.Material.Outlined.EditCalendar" Size="Size.Small" OnClick="() => EditStageDatesAsync(local)" aria-label="Editar fechas de la etapa" /> }</td>
                                    <td>
                                        @if (_canEdit)
                                        {
                                            <MudTextField T="string" Value="local.Notes" ValueChanged="text => SaveNotesAsync(local, text)"
                                                          Placeholder="Notas" Variant="Variant.Text" Margin="Margin.Dense" Style="min-width:160px" />
                                        }
                                        else
                                        {
                                            <span>@local.Notes</span>
                                        }
                                    </td>
                                </tr>
                                @if (local.Code == StageCode.Layout)
                                {
                                    <tr class="tk-permit-row">
                                        <td><strong>Permisos eléctricos</strong></td>
                                        <td colspan="4">
                                            @if (_canEdit)
                                            {
                                                <MudSelect T="PermitStatus" Value="_summary.Site.PermitStatus" ValueChanged="SetPermitAsync"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="tk-inline-select">
                                                    @foreach (var option in Enum.GetValues<PermitStatus>())
                                                    {
                                                        <MudSelectItem T="PermitStatus" Value="option">@ConstructionMath.PermitName(option)</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                <span class="permit-chip permit-chip--@((int)_summary.Site.PermitStatus)">@ConstructionMath.PermitName(_summary.Site.PermitStatus)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </SectionCard></div>

        <div id="sec-control" class="tk-anchor"><SectionCard Title="Control del nodo">
            <div class="tk-flag">
                <div>
                    <div class="tk-flag__label">Supervisión de CAES</div>
                    <div class="tk-flag__help">Solo informativa: no afecta el flujo.</div>
                </div>
                <MudSwitch T="bool" Value="site.CaesSupervised" ValueChanged="SetCaesAsync" Disabled="!_canEdit" Color="Color.Primary" />
            </div>
            <div class="tk-flag">
                <div>
                    <div class="tk-flag__label">ODN finalizada</div>
                    <div class="tk-flag__help">Se marca a mano cuando están puestos los cruces americanos.@(site.OdnFinalizedOn is null ? "" : $" Desde {UiText.Date(site.OdnFinalizedOn)}.")</div>
                </div>
                <MudSwitch T="bool" Value="site.OdnFinalized" ValueChanged="SetOdnAsync" Disabled="!_canEdit" Color="Color.Success" />
            </div>
            <div class="tk-flag">
                <div>
                    <div class="tk-flag__label">Feeder en este nodo</div>
                    <div class="tk-flag__help">¿Ya pasó el feeder (troncal) por la construcción de la ODN?</div>
                </div>
                <MudSelect T="FeederStatus" Value="site.FeederStatus" ValueChanged="SetFeederAsync" Disabled="!_canEdit"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:170px">
                    @foreach (var option in Enum.GetValues<FeederStatus>())
                    {
                        <MudSelectItem T="FeederStatus" Value="option">@UiText.FeederStatusName(option)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="tk-flag">
                <div>
                    <div class="tk-flag__label">Bitácora del supervisor</div>
                    <div class="tk-flag__help">@(site.LogsUpToDate ? $"Actualizada{(site.LogsUpdatedOn is null ? "" : $" el {UiText.Date(site.LogsUpdatedOn)}")}" : "Hay información por actualizar")</div>
                </div>
                <MudSwitch T="bool" Value="site.LogsUpToDate" ValueChanged="SetLogsAsync" Disabled="!_canEdit" Color="Color.Primary" />
            </div>
            @if (!string.IsNullOrWhiteSpace(site.Notes))
            {
                <div class="tk-flag"><div><div class="tk-flag__label">Notas</div><div class="tk-flag__help">@site.Notes</div></div></div>
            }
        </SectionCard>
        <SectionCard Title="Orden de construcción" Class="mt-6">
            <div class="tk-flag"><div><div class="tk-flag__label">HP (hogares que pasa)</div></div><strong>@(site.HomesPassed is { } hp ? UiText.Number(hp) : "—")</strong></div>
            <div class="tk-flag"><div><div class="tk-flag__label">Permisos eléctricos</div></div><strong>@ConstructionMath.PermitName(site.PermitStatus)</strong></div>
            <div class="tk-flag"><div><div class="tk-flag__label">Entrega de materiales</div></div><strong>@YesNoText(site.MaterialsDelivered)</strong></div>
            <div class="tk-flag"><div><div class="tk-flag__label">KMZ</div></div><strong>@DocText(site.KmzStatus)</strong></div>
            <div class="tk-flag"><div><div class="tk-flag__label">Consolidado de UM</div></div><strong>@DocText(site.UmConsolidatedStatus)</strong></div>
            <div class="tk-flag"><div><div class="tk-flag__label">Reporte fotográfico</div></div><strong>@DocText(site.PhotoReportStatus)</strong></div>
            <div class="tk-flag"><div><div class="tk-flag__label">ATP entregado</div></div><strong>@YesNoText(site.AtpDelivered)</strong></div>
        </SectionCard></div>
    </div>

    <div id="sec-cantidades" class="tk-anchor"><SectionCard Title="Cantidades por material" Class="mt-6">
        <HeaderActions>
            <a href="nodos/@Id/liquidacion" class="tk-btn tk-btn--outline">Liquidación</a>
            @if (_canEdit)
            {
                <button type="button" class="tk-btn tk-btn--outline" @onclick="AdjustAsync">Ajustar proyectado</button>
                <button type="button" class="tk-btn tk-btn--primary" @onclick="InstalledAsync">+ Instalado</button>
            }
        </HeaderActions>
        <ChildContent>
            @if (_materials.Count == 0)
            {
                <EmptyState Title="Sin cantidades registradas" Icon="@Icons.Material.Outlined.Inventory2"
                            Description="Importe el Excel de control, cargue la proyección de diseño o registre lo instalado para ver las cantidades de este nodo." />
            }
            else
            {
                <div class="tk-toolbar">
                    <MudTextField @bind-Value="_materialSearch" Immediate="true" Placeholder="Buscar material" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px" />
                    <MudSwitch T="bool" @bind-Value="_onlyPending" Label="Solo con pendiente" Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="_onlyAlert" Label="Solo con alerta" Color="Color.Primary" />
                    <span class="tk-muted">@VisibleMaterials.Count() de @_materials.Count materiales · @_materials.Count(m => m.Projected - m.Installed > 0) con pendiente · @_materials.Count(HasAlert) con alerta</span>
                </div>
                <div class="tk-table-wrap tk-grid-scroll">
                    <table class="tk-table tk-table--compact tk-table--grid">
                        <thead>
                            <tr><th>Material</th><th>UM</th><th>Proyectado (diseño)</th><th>Ajustes</th><th>Proyectado vigente</th><th>Entregado</th><th class="tk-col-installed">Instalado</th><th>Pendiente</th><th>Variación</th><th>Alerta</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var group in VisibleMaterials.GroupBy(m => m.Material.Category))
                            {
                                <tr class="tk-table__group"><td colspan="11"><span class="tk-group-label">@UiText.CategoryName(group.Key)</span></td></tr>
                                @foreach (var m in group)
                                {
                                    <tr>
                                        <td>@m.Material.Name</td>
                                        <td>@m.Material.Unit</td>
                                        <td class="num">@UiText.Number(m.DesignProjected)</td>
                                        <td class="num @(m.Adjustments != 0 ? "text-warning" : "")">@(m.Adjustments > 0 ? "+" : "")@UiText.Number(m.Adjustments)</td>
                                        <td class="num strong">@UiText.Number(m.Projected)</td>
                                        <td class="num">@(m.Material.TracksStock ? UiText.Number(m.Delivered) : "—")</td>
                                        <td class="num tk-installed tk-col-installed">@UiText.Number(m.Installed)</td>
                                        <td class="num @(m.Projected - m.Installed > 0 ? "text-danger" : "")">@(m.Projected == 0 ? "—" : UiText.Number(m.Projected - m.Installed))</td>
                                        <td class="num @(m.Projected == 0 ? "muted" : m.Variation > 0 ? "text-danger" : m.Variation < 0 ? "text-success" : "")">
                                            @(m.Projected == 0 ? "—" : $"{(m.Variation > 0 ? "+" : "")}{m.VariationPercent:0.#}%")
                                        </td>
                                        <td>
                                            @if (m.Projected > 0 && m.Installed > m.Projected)
                                            {
                                                <StatusChip Status="StatusChip.Kind.Atrasado" Text="Instalado > proyectado" />
                                            }
                                            else if (m.Material.TracksStock && m.Projected > 0 && m.Delivered > m.Projected)
                                            {
                                                <StatusChip Status="StatusChip.Kind.Bajo" Text="Entregado > proyectado" />
                                            }
                                            else if (m.Material.TracksStock && m.Installed > m.Delivered)
                                            {
                                                <StatusChip Status="StatusChip.Kind.Dia" Text="Instalado > entregado" />
                                            }
                                        </td>
                                        <td class="tk-actions-cell">
                                            @if (_canEdit)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => EditInstalledAsync(m)" aria-label="Corregir cantidades" />
                                            }
                                            @if (_isAdmin)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveMaterialAsync(m)" aria-label="Quitar del nodo" title="Quitar del nodo" />
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (group.Key == MaterialCategory.NetworkElement)
                                {
                                    var net = _materials.Where(x => SiteSummary.VinetaGroups.Contains(x.Material.Group)).ToList();
                                    var netProjected = net.Sum(x => x.Projected);
                                    var netInstalled = net.Sum(x => x.Installed);
                                    <tr class="tk-table__total">
                                        <td>Total de viñetas (sub-box + end-box + hub-box + x-box)</td>
                                        <td>UND</td>
                                        <td class="num">@UiText.Number(net.Sum(x => x.DesignProjected))</td>
                                        <td class="num">@(net.Sum(x => x.Adjustments) > 0 ? "+" : "")@UiText.Number(net.Sum(x => x.Adjustments))</td>
                                        <td class="num strong">@UiText.Number(netProjected)</td>
                                        <td class="num">@UiText.Number(net.Where(x => x.Material.TracksStock).Sum(x => x.Delivered))</td>
                                        <td class="num tk-installed tk-col-installed">@UiText.Number(netInstalled)</td>
                                        <td class="num @(netProjected - netInstalled > 0 ? "text-danger" : "")">@(netProjected == 0 ? "—" : UiText.Number(netProjected - netInstalled))</td>
                                        <td class="num">@(netProjected == 0 ? "—" : $"{(netInstalled - netProjected > 0 ? "+" : "")}{Math.Round((netInstalled - netProjected) / netProjected * 100m, 1):0.#}%")</td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </SectionCard></div>

    <div class="tk-two-col mt-6">
        <div id="sec-mediciones" class="tk-anchor"><SectionCard Title="Mediciones de FATs">
            <HeaderActions>
                @if (_measureSummary.Measured > 0)
                {
                    <span class="tk-muted">@_measureSummary.Measured medidas · @_measureSummary.Acceptable aceptables · @_measureSummary.NotAcceptable no aceptables</span>
                }
                @if (_canEdit)
                {
                    <button type="button" class="tk-btn tk-btn--primary" @onclick="MeasureAsync">+ Medición</button>
                }
            </HeaderActions>
            <ChildContent>
                @if (_measurements.Count == 0)
                {
                    <EmptyState Title="Sin mediciones" Icon="@Icons.Material.Outlined.Speed"
                                Description="Registre la potencia (dBm) de cada FAT para saber si llega la señal correcta." />
                }
                else
                {
                    <div class="tk-table-wrap">
                        <table class="tk-table tk-table--compact">
                            <thead><tr><th>FAT</th><th>Fecha</th><th>dBm</th><th>Resultado</th><th>Notas</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var m in _measurements.Take(60))
                                {
                                    var local = m;
                                    <tr>
                                        <td>@local.FatCode</td>
                                        <td class="nowrap">@UiText.ShortDate(local.Date)</td>
                                        <td class="num">@local.PowerDbm.ToString("0.##")</td>
                                        <td>@if (local.IsAcceptable) { <StatusChip Status="StatusChip.Kind.Ok" Text="Aceptable" /> } else { <StatusChip Status="StatusChip.Kind.Atrasado" Text="No aceptable" /> }</td>
                                        <td>@local.Notes</td>
                                        <td class="tk-actions-cell">@if (_canEdit) { <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => EditMeasurementAsync(local)" aria-label="Editar medición" /><MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => RemoveMeasurementAsync(local.Id)" aria-label="Quitar medición" /> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ChildContent>
        </SectionCard></div>

        <SectionCard Title="Ajustes de la proyección">
            @if (_adjustments.Count == 0)
            {
                <EmptyState Title="Sin ajustes" Icon="@Icons.Material.Outlined.Tune"
                            Description="Los cambios de cantidad respecto al diseño (por ejemplo, cruces americanos) quedan aquí con su motivo." />
            }
            else
            {
                <div class="tk-table-wrap">
                    <table class="tk-table tk-table--compact">
                        <thead><tr><th>Fecha</th><th>Material</th><th>Ajuste</th><th>Motivo</th><th>Registró</th></tr></thead>
                        <tbody>
                            @foreach (var a in _adjustments)
                            {
                                <tr>
                                    <td class="nowrap">@UiText.ShortDate(a.Date)</td>
                                    <td>@a.Material?.Name</td>
                                    <td class="num @(a.Delta > 0 ? "text-success" : "text-danger")">@(a.Delta > 0 ? "+" : "")@UiText.Number(a.Delta)</td>
                                    <td>@a.Reason</td>
                                    <td class="tk-code-sm">@a.CreatedBy</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </SectionCard>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private SiteSummary? _summary;
    private Project? _project;
    private List<SiteStage> _stages = [];
    private List<MaterialQuantity> _materials = [];
    private string? _materialSearch;
    private bool _onlyPending;
    private bool _onlyAlert;

    private static bool HasAlert(MaterialQuantity m) =>
        (m.Projected > 0 && m.Installed > m.Projected)
        || (m.Material.TracksStock && m.Projected > 0 && m.Delivered > m.Projected)
        || (m.Material.TracksStock && m.Installed > m.Delivered);

    private IEnumerable<MaterialQuantity> VisibleMaterials => _materials
        .Where(m => string.IsNullOrWhiteSpace(_materialSearch) || m.Material.Name.Contains(_materialSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(m => !_onlyPending || m.Projected - m.Installed > 0)
        .Where(m => !_onlyAlert || HasAlert(m));
    private List<FatMeasurement> _measurements = [];
    private List<ProjectionAdjustment> _adjustments = [];
    private MeasurementSummary _measureSummary = new(0, 0, 0);
    private bool _loading = true;
    private bool _canEdit;
    private bool _isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        _canEdit = await Access.CanEditAsync();
        _isAdmin = await Access.IsAdminAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _stages = await Sites.StagesAsync(Id);
        _summary = await Sites.GetSummaryAsync(Id);
        if (_summary is not null)
        {
            _project = await Projects.GetAsync(_summary.Site.ProjectId);
            Selection.Select(_summary.Site.ProjectId);
            _materials = await Quantities.GetSiteMaterialsAsync(Id);
            _measurements = await Measurements.ListAsync(Id);
            _measureSummary = await Measurements.SummaryAsync(Id);
            _adjustments = await Projections.AdjustmentsAsync(Id);
        }

        _loading = false;
    }

    private static IEnumerable<StageStatus> OptionsFor(StageCode code) =>
        code == StageCode.Corrections
            ? [StageStatus.Pending, StageStatus.InProgress, StageStatus.InCorrection, StageStatus.Finished, StageStatus.NotApplicable]
            : [StageStatus.Pending, StageStatus.InProgress, StageStatus.Finished];

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
            await LoadAsync();
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private Task SetStageAsync(SiteStage stage, StageStatus status) =>
        RunAsync(() => Sites.SetStageAsync(Id, stage.Code, status, null, null));

    private Task SaveNotesAsync(SiteStage stage, string? text) =>
        RunAsync(() => Sites.SetStageAsync(Id, stage.Code, stage.Status, null, text));

    private Task SetPermitAsync(PermitStatus status) => RunAsync(() => Sites.SetPermitStatusAsync(Id, status));
    private Task SetCaesAsync(bool value) => RunAsync(() => Sites.SetCaesAsync(Id, value));
    private Task SetOdnAsync(bool value) => RunAsync(() => Sites.SetOdnFinalizedAsync(Id, value));
    private Task SetFeederAsync(FeederStatus value) => RunAsync(() => Sites.SetFeederStatusAsync(Id, value));
    private Task SetLogsAsync(bool value) => RunAsync(() => Sites.SetLogsUpToDateAsync(Id, value));

    private async Task EditAsync()
    {
        var dialog = await Dialogs.ShowAsync<SiteDialog>("Editar nodo",
            new DialogParameters { ["ProjectId"] = _summary!.Site.ProjectId, ["Model"] = _summary.Site },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: "deleted" })
        {
            Navigation.NavigateTo("nodos");
        }
        else if (!result!.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task InstalledAsync()
    {
        var dialog = await Dialogs.ShowAsync<MovementDialog>("Registrar instalado",
            new DialogParameters { ["ProjectId"] = _summary!.Site.ProjectId, ["Kind"] = MovementDialog.MovementKind.Installed, ["LockedSiteId"] = Id },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task EditInstalledAsync(MaterialQuantity quantity)
    {
        var dialog = await Dialogs.ShowAsync<EditQuantitiesDialog>("Corregir cantidades del material",
            new DialogParameters
            {
                ["ProjectId"] = _summary!.Site.ProjectId, ["SiteId"] = Id, ["MaterialId"] = quantity.Material.Id,
                ["MaterialName"] = quantity.Material.Name, ["Unit"] = quantity.Material.Unit, ["TracksStock"] = quantity.Material.TracksStock,
                ["Projected"] = quantity.Projected, ["Delivered"] = quantity.Delivered, ["Installed"] = quantity.Installed,
            },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync();
        }
    }

    private static string YesNoText(bool? value) => value switch { true => "Sí", false => "No", _ => "—" };

    private static string DocText(ClosureDocStatus? status) => status switch
    {
        ClosureDocStatus.Validated => "Validada",
        ClosureDocStatus.PendingContractor => "Pendiente por contratista",
        _ => "—",
    };

    private async Task RemoveMaterialAsync(MaterialQuantity quantity)
    {
        var reason = await DeleteConfirmDialog.AskAsync(Dialogs, "Quitar del nodo", $"¿Quitar «{quantity.Material.Name}» de este nodo?",
            [
                "Se borra su proyectado y sus ajustes.",
                "Lo entregado, instalado y devuelto se anula (no se destruye): lo entregado vuelve a la bodega.",
                "Queda registrado quién lo hizo y por qué.",
            ], askReason: true, buttonLabel: "Quitar del nodo");
        if (reason is null)
        {
            return;
        }

        try
        {
            await Deletion.RemoveMaterialFromSiteAsync(Id, quantity.Material.Id, reason);
            Snackbar.Add($"«{quantity.Material.Name}» ya no está en el nodo.", Severity.Success);
            await LoadAsync();
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

