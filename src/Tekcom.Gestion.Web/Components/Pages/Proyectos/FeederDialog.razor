@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Enums
@using Tekcom.Gestion.Web.Services
@using Tekcom.Gestion.Application.Common.Interfaces
@inject IFeederService Feeder
@inject IDateTimeProvider Clock
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudSelect T="FeederItemKind" @bind-Value="_kind" Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var kind in Enum.GetValues<FeederItemKind>())
                {
                    <MudSelectItem T="FeederItemKind" Value="kind">@FeederLabels.Name(kind)</MudSelectItem>
                }
            </MudSelect>
            @if (Planning)
            {
                <MudNumericField T="decimal" @bind-Value="_quantity" Label="@($"Cantidad proyectada ({FeederLabels.Unit(_kind)})")" Min="0"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
            else
            {
                <DatePick Label="Fecha" @bind-Value="_date" />
                <MudNumericField T="decimal" @bind-Value="_quantity" Label="@($"Cantidad instalada ({FeederLabels.Unit(_kind)})")" Min="0"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_notes" Label="Notas (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public bool Planning { get; set; }
    [Parameter] public FeederItemKind? Kind { get; set; }

    private FeederItemKind _kind;
    private decimal _quantity;
    private DateOnly? _date;
    private string? _notes;

    protected override void OnInitialized()
    {
        _kind = Kind ?? FeederItemKind.Cable12;
        _date = Clock.Today;
    }

    private async Task SaveAsync()
    {
        try
        {
            if (Planning)
            {
                await Feeder.SavePlannedAsync(ProjectId, _kind, _quantity);
            }
            else
            {
                await Feeder.AddEntryAsync(ProjectId, _kind, _date ?? Clock.Today, _quantity, _notes);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
