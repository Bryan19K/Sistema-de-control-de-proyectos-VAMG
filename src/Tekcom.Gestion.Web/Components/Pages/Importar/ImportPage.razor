@page "/importar"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Import
@using Tekcom.Gestion.Application.Models
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Entities
@using Tekcom.Gestion.Web.Services
@inject IDataImportCoordinator Importer
@inject ILoadVerificationService Verification
@inject ImportStaging Staging
@inject AuthenticationStateProvider Authentication
@inject IProjectService Projects
@inject ProjectSelection Selection
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Importar Excel · TEK-COM</PageTitle>

<PageHeader Title="Importar Excel" Subtitle="Suba cualquiera de los Excel de TEK-COM: el sistema detecta qué trae y lo carga sin duplicar" />

<SectionCard Title="Verificación de la carga" Class="mb-6">
    <HeaderActions>
        <button type="button" class="tk-btn tk-btn--outline" @onclick="VerifyAsync" disabled="@_verifying">Verificar de nuevo</button>
    </HeaderActions>
    <ChildContent>
        @if (_verification is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @if (_verification.AllLoaded)
            {
                <div class="tk-alert tk-alert--info mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    <span><strong>Todos los Excel están cargados.</strong>
                        @(_verification.Differences == 0 ? "Las cifras coinciden con las de cada archivo." : $"{_verification.Differences} cifra(s) difieren de las del Excel: suele ser porque ya las editó en el sistema.")</span>
                </div>
            }
            else
            {
                <div class="tk-alert tk-alert--warning mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" />
                    <span><strong>Faltan por cargar:</strong> @string.Join(", ", _verification.Missing)</span>
                </div>
            }

            <div class="tk-table-wrap">
                <table class="tk-table tk-table--compact">
                    <thead><tr><th>Excel</th><th>Qué trae</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var file in _verification.Files)
                        {
                            <tr>
                                <td>@file.File</td>
                                <td>@file.Description</td>
                                <td>
                                    @if (!file.Loaded) { <StatusChip Status="StatusChip.Kind.Atrasado" Text="Falta" /> }
                                    else if (file.Differences > 0) { <StatusChip Status="StatusChip.Kind.Bajo" Text="@($"Cargado · {file.Differences} difiere")" /> }
                                    else { <StatusChip Status="StatusChip.Kind.Ok" Text="Cargado" /> }
                                </td>
                                <td>
                                    <details>
                                        <summary>Ver cifras</summary>
                                        <table class="tk-table tk-table--compact">
                                            <thead><tr><th>Dato</th><th class="num">Excel</th><th class="num">Sistema</th><th></th></tr></thead>
                                            <tbody>
                                                @foreach (var check in file.Checks)
                                                {
                                                    <tr>
                                                        <td>@check.Name</td><td class="num">@check.Expected</td><td class="num">@check.Actual</td>
                                                        <td>@if (check.State == LoadCheckState.Ok) { <StatusChip Status="StatusChip.Kind.Ok" Text="Coincide" /> } else if (check.State == LoadCheckState.Missing) { <StatusChip Status="StatusChip.Kind.Atrasado" Text="Falta" /> } else { <StatusChip Status="StatusChip.Kind.Bajo" Text="Difiere" /> }</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="tk-muted mt-2">"Difiere" no es un error: todo se puede editar en el sistema, así que las cifras cambian. Si no editó nada y falta algo, vuelva a subir ese Excel.</p>
        }
    </ChildContent>
</SectionCard>

<SectionCard Title="1. Elija el archivo" Class="mb-6">
    <p class="mb-3">
        Sirven el Excel de control FTTH (con sus hojas de bodega), el control de proyectos NextWave, el control de materiales de NextWave,
        los gastos, el preciario, la base de contratistas y la asignación de nodos (HP, permisos, brigadas). El sistema le muestra qué encontró <strong>antes de guardar nada</strong> y puede subir el mismo archivo otra vez sin duplicar.
    </p>
    @if (Error is "archivo")
    {
        <div class="tk-alert tk-alert--warning mb-3"><span>Elija un archivo Excel (.xlsx).</span></div>
    }
    else if (Error is "tamano")
    {
        <div class="tk-alert tk-alert--warning mb-3"><span>El archivo supera los 25 MB.</span></div>
    }
    @if (_staged?.Error is { } stagedError)
    {
        <div class="tk-alert tk-alert--warning mb-3"><span>@stagedError</span></div>
    }
    <form method="post" action="importar/subir" enctype="multipart/form-data" class="tk-toolbar">
        <input type="file" name="archivo" accept=".xlsx" required />
        <button type="submit" class="tk-btn tk-btn--primary">Leer archivo</button>
    </form>
    @if (_staged is not null && _staged.Error is null)
    {
        <p class="mt-2 tk-muted">Archivo leído: @_staged.FileName</p>
    }
</SectionCard>

@if (_done is not null)
{
    <div class="tk-alert tk-alert--info mb-6">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
        <span><strong>Importación terminada.</strong> Revise el resultado de cada bloque y la validación de totales.</span>
    </div>
    @foreach (var pack in _done)
    {
        <h2 class="tk-h2 mb-3">@pack.Title</h2>
        @if (pack.Kind == PackKind.FtthControl)
        {
            <ImportReportView Report="pack.Report" />
        }
        else
        {
            <PackReportView Report="pack.Report" />
        }
    }
    <div class="tk-toolbar">
        <a href="importar" class="tk-btn tk-btn--primary">Subir otro archivo</a>
        <a href="proyectos" class="tk-btn tk-btn--outline">Ver proyectos</a>
        <a href="materiales" class="tk-btn tk-btn--outline">Ver materiales</a>
        <a href="edificios" class="tk-btn tk-btn--outline">Ver edificios</a>
        <a href="gastos" class="tk-btn tk-btn--outline">Ver gastos</a>
    </div>
}
else if (_packs.Count > 0)
{
    @foreach (var pack in _packs)
    {
        <h2 class="tk-h2 mb-1">@pack.Title</h2>
        <p class="tk-muted mb-3">@pack.Description</p>
        @if (pack.Kind == PackKind.FtthControl)
        {
            <ImportReportView Report="pack.Report" />
        }
        else
        {
            <PackReportView Report="pack.Report" />
        }
    }

    @if (NeedsTarget)
    {
        <SectionCard Title="2. ¿Dónde se importa?" Class="mb-6">
            @if (HasFtth)
            {
                <MudRadioGroup T="bool" @bind-Value="_useExisting">
                    <MudRadio T="bool" Value="false">Crear un proyecto nuevo con este Excel</MudRadio>
                    <MudRadio T="bool" Value="true" Disabled="_projects.Count == 0">Agregar a un proyecto existente</MudRadio>
                </MudRadioGroup>
            }
            else
            {
                <p class="mb-2">Estos datos se cargan en el proyecto FTTH que elija.</p>
            }

            @if (_useExisting || !HasFtth)
            {
                <MudSelect T="int" @bind-Value="_projectId" Label="Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:420px" Class="mt-3">
                    @foreach (var p in _projects)
                    {
                        <MudSelectItem T="int" Value="p.Id">@p.Name (@p.Code)</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <div class="tk-toolbar mt-3">
                    <MudTextField @bind-Value="_newCode" Label="Código del proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px" />
                    <MudTextField @bind-Value="_newName" Label="Nombre del proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:360px" />
                </div>
            }
        </SectionCard>
    }

    <div class="tk-toolbar mt-4 mb-6">
        <button type="button" class="tk-btn tk-btn--primary" @onclick="ApplyAsync" disabled="@(_busy || _packs.All(p => p.Report.Errors > 0 && p.Kind != PackKind.FtthControl && p.Report.Summary.Count == 0))">
            Importar todo (@_packs.Count @(_packs.Count == 1 ? "bloque" : "bloques"))
        </button>
        <span class="tk-muted">No se borra nada de lo que ya registró: solo se agrega o se actualiza lo que viene del Excel.</span>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "archivo")] public string? ArchivoId { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private StagedImport? _staged;
    private List<PackAnalysis> _packs = [];
    private List<PackAnalysis>? _done;
    private bool _busy;
    private List<Project> _projects = [];
    private bool _useExisting;
    private int _projectId;
    private string? _newCode;
    private string? _newName;
    private string? _loadedId;

    private bool HasFtth => _packs.Any(p => p.Kind == PackKind.FtthControl);
    private bool NeedsTarget => HasFtth || _packs.Any(p => p.NeedsProject);

    private LoadVerification? _verification;
    private bool _verifying;

    protected override async Task OnInitializedAsync()
    {
        _projects = await Projects.ListAsync();
        await VerifyAsync();
    }

    private async Task VerifyAsync()
    {
        _verifying = true;
        try
        {
            _verification = await Verification.VerifyAsync();
        }
        finally
        {
            _verifying = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == ArchivoId)
        {
            return;
        }

        _loadedId = ArchivoId;
        var user = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? string.Empty;
        _staged = Staging.Get(ArchivoId, user);
        _packs = _staged?.Packs ?? [];
        _done = _staged?.Done;
        if (_packs.Count == 0)
        {
            return;
        }

        var ftth = _packs.FirstOrDefault(p => p.Kind == PackKind.FtthControl);
        _newCode = ftth?.Report.SuggestedProjectCode;
        _newName = ftth?.Report.SuggestedProjectName;
        var ftthProjects = _projects.Where(p => p.ProjectType?.Code == "FTTH").ToList();
        _projectId = ftthProjects.FirstOrDefault(p => p.Id == Selection.CurrentId)?.Id
            ?? ftthProjects.FirstOrDefault()?.Id ?? Selection.CurrentId ?? _projects.FirstOrDefault()?.Id ?? 0;
        _useExisting = false;
    }

    private async Task ApplyAsync()
    {
        if (_packs.Count == 0 || _staged is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var existing = _useExisting || !HasFtth;
            var target = existing ? new ImportTarget(_projectId == 0 ? null : _projectId, null, null) : new ImportTarget(null, _newCode, _newName);
            _done = await Importer.ApplyAsync(_packs, target);
            _staged.Done = _done;
            _projects = await Projects.ListAsync();
            await VerifyAsync();
            Snackbar.Add("Importación terminada.", Severity.Success);
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
