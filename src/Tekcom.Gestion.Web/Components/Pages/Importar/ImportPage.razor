@page "/importar"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Import
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Entities
@using Tekcom.Gestion.Web.Services
@inject IDataImportCoordinator Importer
@inject IProjectService Projects
@inject ProjectSelection Selection
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Importar Excel · TEK-COM</PageTitle>

<PageHeader Title="Importar Excel" Subtitle="Suba cualquiera de los Excel de TEK-COM: el sistema detecta qué trae y lo carga sin duplicar" />

<SectionCard Title="1. Elija el archivo" Class="mb-6">
    <p class="mb-3">
        Sirven el Excel de control FTTH (con sus hojas de bodega), el control de proyectos NextWave, el control de materiales de NextWave,
        los gastos y el preciario. El sistema le muestra qué encontró <strong>antes de guardar nada</strong> y puede subir el mismo archivo otra vez sin duplicar.
    </p>
    <InputFile OnChange="OnFileAsync" accept=".xlsx" disabled="@_busy" />
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-3" />
    }
    @if (_fileName is not null && !_busy)
    {
        <p class="mt-2 tk-muted">Archivo leído: @_fileName</p>
    }
</SectionCard>

@if (_done is not null)
{
    <div class="tk-alert tk-alert--info mb-6">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
        <span><strong>Importación terminada.</strong> Revise el resultado de cada bloque y la validación de totales.</span>
    </div>
    @foreach (var pack in _done)
    {
        <h2 class="tk-h2 mb-3">@pack.Title</h2>
        @if (pack.Kind == PackKind.FtthControl)
        {
            <ImportReportView Report="pack.Report" />
        }
        else
        {
            <PackReportView Report="pack.Report" />
        }
    }
    <div class="tk-toolbar">
        <a href="proyectos" class="tk-btn tk-btn--primary">Ver proyectos</a>
        <a href="materiales" class="tk-btn tk-btn--outline">Ver materiales</a>
        <a href="edificios" class="tk-btn tk-btn--outline">Ver edificios</a>
        <a href="gastos" class="tk-btn tk-btn--outline">Ver gastos</a>
    </div>
}
else if (_packs.Count > 0)
{
    @foreach (var pack in _packs)
    {
        <h2 class="tk-h2 mb-1">@pack.Title</h2>
        <p class="tk-muted mb-3">@pack.Description</p>
        @if (pack.Kind == PackKind.FtthControl)
        {
            <ImportReportView Report="pack.Report" />
        }
        else
        {
            <PackReportView Report="pack.Report" />
        }
    }

    @if (NeedsTarget)
    {
        <SectionCard Title="2. ¿Dónde se importa?" Class="mb-6">
            @if (HasFtth)
            {
                <MudRadioGroup T="bool" @bind-Value="_useExisting">
                    <MudRadio T="bool" Value="false">Crear un proyecto nuevo con este Excel</MudRadio>
                    <MudRadio T="bool" Value="true" Disabled="_projects.Count == 0">Agregar a un proyecto existente</MudRadio>
                </MudRadioGroup>
            }
            else
            {
                <p class="mb-2">Estos datos se cargan en el proyecto FTTH que elija.</p>
            }

            @if (_useExisting || !HasFtth)
            {
                <MudSelect T="int" @bind-Value="_projectId" Label="Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:420px" Class="mt-3">
                    @foreach (var p in _projects)
                    {
                        <MudSelectItem T="int" Value="p.Id">@p.Name (@p.Code)</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <div class="tk-toolbar mt-3">
                    <MudTextField @bind-Value="_newCode" Label="Código del proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px" />
                    <MudTextField @bind-Value="_newName" Label="Nombre del proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:360px" />
                </div>
            }
        </SectionCard>
    }

    <div class="tk-toolbar mt-4 mb-6">
        <button type="button" class="tk-btn tk-btn--primary" @onclick="ApplyAsync" disabled="@(_busy || _packs.All(p => p.Report.Errors > 0 && p.Kind != PackKind.FtthControl && p.Report.Summary.Count == 0))">
            Importar todo (@_packs.Count @(_packs.Count == 1 ? "bloque" : "bloques"))
        </button>
        <span class="tk-muted">No se borra nada de lo que ya registró: solo se agrega o se actualiza lo que viene del Excel.</span>
    </div>
}

@code {
    private List<PackAnalysis> _packs = [];
    private List<PackAnalysis>? _done;
    private string? _fileName;
    private bool _busy;
    private List<Project> _projects = [];
    private bool _useExisting;
    private int _projectId;
    private string? _newCode;
    private string? _newName;

    private bool HasFtth => _packs.Any(p => p.Kind == PackKind.FtthControl);
    private bool NeedsTarget => HasFtth || _packs.Any(p => p.NeedsProject);

    protected override async Task OnInitializedAsync() => _projects = await Projects.ListAsync();

    private async Task OnFileAsync(InputFileChangeEventArgs args)
    {
        _done = null;
        _packs = [];
        var file = args.File;
        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Seleccione un archivo Excel (.xlsx).", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _packs = await Importer.AnalyzeAsync(memory.ToArray(), file.Name);
            _fileName = file.Name;
            if (_packs.Count == 0)
            {
                Snackbar.Add("No reconocí este Excel. Use el control FTTH, el control de proyectos NextWave, sus materiales, los gastos o el preciario.", Severity.Warning);
                return;
            }

            var ftth = _packs.FirstOrDefault(p => p.Kind == PackKind.FtthControl);
            _newCode = ftth?.Report.SuggestedProjectCode;
            _newName = ftth?.Report.SuggestedProjectName;
            var ftthProjects = _projects.Where(p => p.ProjectType?.Code == "FTTH").ToList();
            _projectId = ftthProjects.FirstOrDefault(p => p.Id == Selection.CurrentId)?.Id
                ?? ftthProjects.FirstOrDefault()?.Id ?? Selection.CurrentId ?? _projects.FirstOrDefault()?.Id ?? 0;
            _useExisting = false;
        }
        catch (IOException)
        {
            Snackbar.Add("No se pudo leer el archivo. Verifique que no supere 25 MB.", Severity.Error);
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyAsync()
    {
        if (_packs.Count == 0)
        {
            return;
        }

        _busy = true;
        try
        {
            var existing = _useExisting || !HasFtth;
            var target = existing ? new ImportTarget(_projectId == 0 ? null : _projectId, null, null) : new ImportTarget(null, _newCode, _newName);
            _done = await Importer.ApplyAsync(_packs, target);
            _projects = await Projects.ListAsync();
            Snackbar.Add("Importación terminada.", Severity.Success);
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
