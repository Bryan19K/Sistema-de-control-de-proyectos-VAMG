@page "/dashboard"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Tekcom.Gestion.Web.Services

<PageTitle>Dashboard · TEK-COM</PageTitle>

@if (_gastos)
{
    <ExpensesDashboard />
}
else
{
    <PresentationPage />
}

@code {
    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _gastos;

    protected override async Task OnParametersSetAsync()
    {
        // "Gastos y precios" es solo del administrador, igual que su pantalla de detalle.
        var state = AuthState is null ? null : await AuthState;
        _gastos = string.Equals(Vista, "gastos", StringComparison.OrdinalIgnoreCase) && state?.User.IsInRole(AppRoles.Admin) == true;
    }
}
