@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Entities
@inject IWorkPlanService Plan
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Nombre de la fase" Required="true" Placeholder="Fase 1 · Preparación" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public WorkPlanPhase? Model { get; set; }

    private string _name = string.Empty;

    protected override void OnInitialized() => _name = Model?.Name ?? string.Empty;

    private async Task SaveAsync()
    {
        try
        {
            var phase = Model ?? new WorkPlanPhase { ProjectId = ProjectId };
            phase.Name = _name;
            await Plan.SavePhaseAsync(phase);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
