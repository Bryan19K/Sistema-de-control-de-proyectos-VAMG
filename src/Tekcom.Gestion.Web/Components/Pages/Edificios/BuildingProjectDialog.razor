@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Entities
@using Tekcom.Gestion.Domain.Enums
@using Tekcom.Gestion.Web.Services
@inject IBuildingService Buildings
@inject ISnackbar Snackbar
@inject IDeletionService Deletion
@inject IDialogService Dialogs
@inject UserAccess Access
@inject ProjectSelection Selection

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6"><MudNumericField Format="0.##" T="decimal?" @bind-Value="_progress" Label="Avance global (%)" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="ProjectStatus" @bind-Value="_status" Label="Estado" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var s in Enum.GetValues<ProjectStatus>())
                    {
                        <MudSelectItem T="ProjectStatus" Value="s">@UiText.ProjectStatusName(s)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_pending" Label="Trabajos por ejecutar" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_responsible" Label="Responsable" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><DatePick Label="Inicio" @bind-Value="_start" /></MudItem>
            <MudItem xs="12" sm="6"><DatePick Label="Fin" @bind-Value="_end" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (_isAdmin && Model is not null)
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync" Style="margin-right:auto">Eliminar proyecto</MudButton>
        }
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Project Model { get; set; } = default!;

    private decimal? _progress;
    private ProjectStatus _status;
    private string? _pending;
    private string? _responsible;
    private DateOnly? _start;
    private DateOnly? _end;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await Access.IsAdminAsync();
        _progress = Model.ReportedProgress;
        _status = Model.Status;
        _pending = Model.PendingWork;
        _responsible = Model.ResponsibleName;
        _start = Model.PlannedStart;
        _end = Model.PlannedEnd;
    }

    private async Task DeleteAsync()
    {
        var impact = await Deletion.ProjectImpactAsync(Model.Id);
        var reason = await DeleteConfirmDialog.AskAsync(Dialogs, "Eliminar proyecto", $"¿Eliminar el proyecto {Model.Code} completo?",
            [
                "Se ocultan sus fases, niveles, apartamentos, gastos y todo lo suyo.",
                $"Se anulan sus {impact.Movements} movimientos de bodega.",
                "Queda registrado quién lo eliminó y por qué; no se destruye nada en la base.",
            ], askReason: true, confirmText: Model.Code, buttonLabel: "Eliminar proyecto");
        if (reason is null)
        {
            return;
        }

        try
        {
            await Deletion.DeleteProjectAsync(Model.Id, reason);
            Selection.Forget(Model.Id);
            Snackbar.Add($"Proyecto {Model.Code} eliminado.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            await Buildings.SaveProjectAsync(Model.Id, _progress, _pending, _status, _responsible, _start, _end);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
