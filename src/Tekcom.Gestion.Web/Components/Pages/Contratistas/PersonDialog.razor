@using Tekcom.Gestion.Application.Common
@using Tekcom.Gestion.Application.Models
@using Tekcom.Gestion.Application.Services
@using Tekcom.Gestion.Domain.Entities
@inject IContractorDirectoryService Directory
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="int" @bind-Value="_m.ContractorId" Label="Contratista" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var c in _contractors)
                    {
                        <MudSelectItem T="int" Value="c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="_m.FullName" Label="Nombre completo" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_m.Dui" Label="DUI" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.Position" Label="Cargo" Placeholder="Encargado de cuadrilla, auxiliar, técnico cablero…" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.Phone" Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.InsuranceType" Label="Tipo de seguro" Placeholder="ISSS, Seguro de vida…" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.Insurer" Label="Aseguradora" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.PolicyNumber" Label="No. de póliza o de afiliación" HelperText="Si está vacío, queda como pendiente" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_m.InsuranceStatus" Label="Estado" Placeholder="Vigente, Inscrito, PENDIENTE…" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><DatePick Label="Fin de la vigencia" @bind-Value="_m.CoverageEnd" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_m.Notes" Label="Observaciones" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12"><MudSwitch T="bool" @bind-Value="_m.IsActive" Label="Activo (sigue en campo)" Color="Color.Primary" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ContractorPerson? Model { get; set; }
    [Parameter] public int? ContractorId { get; set; }

    private ContractorPerson _m = new();
    private List<Contractor> _contractors = [];

    protected override async Task OnInitializedAsync()
    {
        _contractors = (await Directory.ListAsync(includeInactive: false)).Select(v => v.Contractor).ToList();
        _m = Model is null ? new ContractorPerson { ContractorId = ContractorId ?? 0 } : new ContractorPerson
        {
            Id = Model.Id, ContractorId = Model.ContractorId, FullName = Model.FullName, Dui = Model.Dui, Position = Model.Position,
            Phone = Model.Phone, InsuranceType = Model.InsuranceType, InsuranceStatus = Model.InsuranceStatus, Insurer = Model.Insurer,
            PolicyNumber = Model.PolicyNumber, CoverageEnd = Model.CoverageEnd, Notes = Model.Notes, IsActive = Model.IsActive,
        };
    }

    private async Task SaveAsync()
    {
        try
        {
            var saved = await Directory.SavePersonAsync(_m);
            MudDialog.Close(DialogResult.Ok(saved.Id));
        }
        catch (BusinessRuleException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
